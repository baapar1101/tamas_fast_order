{
  "name": "tamas-fast-order",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "payment"
  ],
  "scripts": {
    "postinstall": "node scripts/fix-perms.js",
    "prebuild": "node scripts/fix-perms.js",
    "predev": "node scripts/fix-perms.js",
    "fix:perms": "node scripts/fix-perms.js",
    "dev": "npm-run-all --parallel dev:shared dev:api dev:web",
    "dev:api": "npm run dev -w @tamas/api",
    "dev:web": "npm run dev -w @tamas/web",
    "build": "npm run build -w @tamas/shared && npm run build -w @tamas/api && npm run build -w @tamas/web",
    "typecheck": "npm run build -w @tamas/shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "db:generate": "npm run db:generate -w @tamas/api",
    "db:migrate": "npm run db:migrate -w @tamas/api",
    "db:seed": "npm run db:seed -w @tamas/api",
    "sync:pull": "npm run sync:pull -w @tamas/api",
    "sync:push": "npm run sync:push -w @tamas/api",
    "images:mirror": "npm run images:mirror -w @tamas/api",
    "images:repair-missing": "npm run images:repair-missing -w @tamas/api --",
    "images:import-sku": "npm run images:import-sku -w @tamas/api --",
    "products:repair-codes": "tsx apps/api/scripts/repair-product-code-prefixes.ts",
    "products:clean-title-colors": "npm run products:clean-title-colors -w @tamas/api --",
    "products:normalize-title-case": "npm run products:normalize-title-case -w @tamas/api --",
    "jules": "node scripts/jules.mjs",
    "test": "npm run test -w @tamas/shared && npm run test -w @tamas/api",
    "start": "npm run start -w @tamas/api",
    "start:prod": "npm run start:prod -w @tamas/api",
    "dev:shared": "npm run dev -w @tamas/shared"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "npm-run-all2": "^7.0.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  }
}
