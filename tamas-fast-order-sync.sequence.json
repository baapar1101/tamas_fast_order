  "activations": [
    { "participant": "web", "from": 160, "to": 472, "type": "frontend" },
    { "participant": "api", "from": 160, "to": 444, "type": "backend" },
    { "participant": "gsheets", "from": 188, "to": 388, "type": "cloud" },
    { "participant": "db", "from": 216, "to": 416, "type": "database" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Three-Way Merge",
      "items": [
        "Row content is merged against the sheetHash captured the last time both sides agreed.",
        "A hand edit in the sheet counts even when nobody touched updated_at - the hash is the source of truth."
      ]
    },
    {
      "dot": "rose",
      "title": "Conflicts",
      "items": [
        "When both sides changed, the differing fields are recorded in syncConflicts.",
        "The timestamp determines the winner; sheet rows without a timestamp never win."
      ]
    },
    {
      "dot": "cyan",
      "title": "Atomicity",
      "items": [
        "Pull and push share one runSync() lock; dryRun reports changes without writing.",
        "Only after the sheet write lands is markSynced() called, so the new baseline is always true.",
        "syncState tracks lastPulledAt / lastPushedAt and per-entity errors."
      ]
    }
  ]
}