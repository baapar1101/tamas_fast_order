    { "id": "m6", "from": "api", "to": "db", "y": 300, "label": "apply sheet row (sheet wins)", "variant": "emphasis", "note": "sheetChanged && dbChanged -> recordConflicts()" },
    { "id": "m7", "from": "db", "to": "api", "y": 328, "label": "created / updated / skipped", "variant": "return" },
