{"nodes":[{"id":"awesome_design_md_main_design_md_notion_design_notion_design_system","label":"Notion Design System","file_type":"document","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\notion\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"awesome_design_md_main_design_md_notion_design_notion_sans","label":"Notion Sans Typeface","file_type":"concept","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\notion\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"awesome_design_md_main_design_md_notion_design_purple_cta","label":"Notion Purple Primary CTA","file_type":"concept","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\notion\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Signature purple pill (#5645d4) is reserved for the dominant CTA only - the recognizable 'Get Notion free' button color that anchors the brand."},{"id":"awesome_design_md_main_design_md_notion_design_brand_navy_hero","label":"Brand Navy Hero Band","file_type":"concept","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\notion\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"awesome_design_md_main_design_md_notion_design_rectangular_geometry","label":"Rectangular-Sober Button Geometry","file_type":"rationale","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\notion\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Buttons use rounded.md (8px) rectangles, deliberately NOT pills - a documented choice distinguishing Notion's sober editorial geometry from pill-button-everywhere competitors."},{"id":"awesome_design_md_main_design_md_notion_design_centered_hero","label":"Centered Hero Layout","file_type":"rationale","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\notion\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Centered hero composition chosen to stand apart from the left-aligned norm of most B2B SaaS landing pages."},{"id":"awesome_design_md_main_design_md_notion_design_pricing_comparison","label":"Four-Tier Pricing Comparison","file_type":"concept","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\notion\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"awesome_design_md_main_design_md_notion_design_pastel_feature_cards","label":"Pastel Feature Card Palette","file_type":"concept","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\notion\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Pastel card tints (peach, rose, mint, lavender, sky, yellow) echo the colorful database properties of the live Notion product."},{"id":"awesome_design_md_main_design_md_notion_design_workspace_mockup","label":"Embedded Workspace UI Mockup","file_type":"concept","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\notion\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A real Notion workspace UI mockup (Ramp HQ kanban board) breaks out of the hero with a deep diffuse drop shadow so visitors see the live product on the page."},{"id":"awesome_design_md_main_design_md_notion_design_flat_surface_cards","label":"Flat Surface Card Treatment","file_type":"rationale","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\notion\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Elevation is capped at level 0-1 for cards; tables and documentation cards stay flat with hairline borders and no heavy resting shadows."},{"id":"awesome_design_md_main_design_md_notion_readme_getdesign_pointer","label":"Notion Design-MD on getdesign.md","file_type":"concept","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\notion\\README.md","source_location":null,"source_url":"https://getdesign.md/notion/design-md","captured_at":null,"author":null,"contributor":null},{"id":"awesome_design_md_main_design_md_nvidia_design_nvidia_design_system","label":"NVIDIA Design System","file_type":"document","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\nvidia\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"awesome_design_md_main_design_md_nvidia_design_nvidia_green","label":"NVIDIA Green Accent","file_type":"concept","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\nvidia\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"#76b900 carries every primary CTA, every active tab, every link affordance on dark surfaces, and decorative corner squares - the entire brand signal in one color."},{"id":"awesome_design_md_main_design_md_nvidia_design_nvidia_emea","label":"NVIDIA-EMEA Typeface","file_type":"concept","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\nvidia\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"NVIDIA-EMEA is brand-locked to every text role; the closest open-source pairing is Inter (weights 400/700) while Arial is the official documented fallback."},{"id":"awesome_design_md_main_design_md_nvidia_design_two_surface_architecture","label":"Two-Surface Chapter Architecture","file_type":"rationale","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\nvidia\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Deep black surface-dark hero/footer chapters frame a paper-white canvas body, alternating in a predictable rhythm so air comes from surface contrast, not padding."},{"id":"awesome_design_md_main_design_md_nvidia_design_hyper_angular_geometry","label":"Hyper-Angular 2px Geometry","file_type":"rationale","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\nvidia\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"rounded.sm (2px) on every element gives the precise, technical feel of CAD engineering output rather than warm consumer software."},{"id":"awesome_design_md_main_design_md_nvidia_design_corner_square","label":"Green Corner-Square Motif","file_type":"concept","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\nvidia\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A 12x12px solid NVIDIA Green square anchored to a card corner is the system's only consistent ornamental device and its identity tag."},{"id":"awesome_design_md_main_design_md_nvidia_design_single_accent_system","label":"Single-Accent Color System","file_type":"rationale","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\nvidia\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Exactly one accent color does all the work and nothing else competes - the system is intentionally one-color and the brand green is treated as precious."},{"id":"awesome_design_md_main_design_md_nvidia_design_flat_hairline_cards","label":"Hairline-Bordered Flat Cards","file_type":"rationale","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\nvidia\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Cards do not lift: card separation comes from 1px hairline borders and surface-soft backgrounds, with drop shadows reserved only for sticky chrome."},{"id":"awesome_design_md_main_design_md_nvidia_design_font_awesome","label":"Font Awesome 6 Pro Iconography","file_type":"concept","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\nvidia\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"awesome_design_md_main_design_md_nvidia_readme_getdesign_pointer","label":"NVIDIA Design-MD on getdesign.md","file_type":"concept","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\nvidia\\README.md","source_location":null,"source_url":"https://getdesign.md/nvidia/design-md","captured_at":null,"author":null,"contributor":null},{"id":"awesome_design_md_main_design_md_playstation_design_playstation_design_system","label":"PlayStation Design System","file_type":"document","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\playstation\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"awesome_design_md_main_design_md_playstation_design_playstation_blue","label":"PlayStation Blue Primary","file_type":"concept","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\playstation\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"PlayStation Blue (#0070d1) is the universal primary CTA and footer surface - reserved and precious, at most one full-bleed blue band per page."},{"id":"awesome_design_md_main_design_md_playstation_design_playstation_sst","label":"PlayStation SST Typeface","file_type":"concept","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\playstation\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Proprietary SST sans renders display copy at weight 300 (light) - unusual for a gaming brand - which gives chrome an airy, editorial quality; Roboto Light and Inter are the closest open-source substitutes."},{"id":"awesome_design_md_main_design_md_playstation_design_three_canvas_chapters","label":"Three-Canvas Chapter System","file_type":"rationale","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\playstation\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Alternating black, white, and PlayStation Blue full-bleed bands scroll like a console launch trailer; the section background change IS the divider."},{"id":"awesome_design_md_main_design_md_playstation_design_light_display_weight","label":"Light-Weight 300 Display Headlines","file_type":"rationale","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\playstation\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Display headlines render at weight 300 (light) so copy reads as information rather than decoration and the imagery does the storytelling."},{"id":"awesome_design_md_main_design_md_playstation_design_pill_ctas","label":"Fully-Rounded Pill CTAs","file_type":"concept","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\playstation\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Every CTA is a fully-rounded pill at rounded.full (9999px); CTAs are always pills - no medium-radius buttons."},{"id":"awesome_design_md_main_design_md_playstation_design_commerce_orange","label":"Commerce Orange Store CTA","file_type":"concept","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\playstation\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Commerce orange (#d53b00) is the only warm color in the system and is reserved exclusively for store/buy/pre-order actions, never marketing chrome."},{"id":"awesome_design_md_main_design_md_playstation_design_ps_plus_gold","label":"PlayStation Plus Gold Gradient","file_type":"concept","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\playstation\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The only gradient in the system - a three-stop gold (ffce21 to ee8e00) reserved exclusively for the PS Plus tier banner, never used on other components."},{"id":"awesome_design_md_main_design_md_playstation_design_flat_surface_cards","label":"Flat Surface Card Treatment","file_type":"rationale","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\playstation\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"No resting shadow on cards; depth is built from surface-color contrast across band chapters and cards lift only on press."},{"id":"awesome_design_md_main_design_md_playstation_design_imagery_dominant","label":"Imagery-Dominant Sections","file_type":"rationale","source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\playstation\\DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Game key art and console renders occupy 60-90% of every band with copy compressed into a small editorial slot - imagery does the storytelling."}],"edges":[{"source":"awesome_design_md_main_design_md_notion_design_notion_design_system","target":"awesome_design_md_main_design_md_notion_design_notion_sans","relation":"references","confidence":"EXTRACTED","confidence_score":1.0,"source_file":"D:\\tamas_fast_order\\awesome-design-md-main\\design-md\\notion\\DESIGN.md","source_location":null,"weight":1.0},{"source":"awesome_design_md_main_design_md_notion_design_notion_design_system","target":"awesome_design_md_m