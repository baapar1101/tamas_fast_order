# Copy to docker/app.env and fill in. docker/app.env is git-ignored: keep
# real passwords and API keys only there. Every key the API understands is
# listed in apps/api/.env.example; the ones below are what Docker needs.

# ---- database (the `db` container) ----
# Use the same password in both lines. Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://tamas:CHANGE_ME@db:5432/tamas
DATABASE_POOL_MAX=10

# ---- site ----
# The address customers open (payment callbacks and links use it).
PUBLIC_SITE_URL=https://tamasmarket.com
# Browsers allowed to call the API: the same address as above.
CORS_ORIGINS=https://tamasmarket.com
# Long random string. Generate one: openssl rand -hex 32
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
SESSION_TTL_DAYS=30
LOG_LEVEL=info
# Phone numbers (comma-separated) that get the admin panel on first login.
ADMIN_PHONES=

# ---- login codes (OTP) ----
# console = the code is printed in `docker compose logs api` (for testing only).
# For real SMS use rastin / payamresan / melipayamak and fill that provider below.
OTP_PROVIDER=console
SMS_PROVIDER=rastin
SMS_FALLBACK_PROVIDER=none
SMS_SECOND_FALLBACK_PROVIDER=none
RASTIN_SMS_USERNAME=
RASTIN_SMS_PASSWORD=
RASTIN_SMS_FROM=
PAYAMRESAN_API_KEY=
PAYAMRESAN_SENDER=
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_FROM=
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
SMSIR_OTP_TEMPLATE_ID=

# ---- uploads (stored on Docker volumes; leave as is) ----
STORAGE_PUBLIC_URL=/uploads
UPLOAD_MAX_BYTES=15728640
PRODUCT_IMAGE_MIRROR_ENABLED=true

# ---- CRM (Hesabix / MarkStreet) ----
CRM_API_BASE=https://tamastore.ir
CRM_API_KEY=
CRM_BUSINESS_ID=1
CRM_WEBHOOK_SECRET=
# Set to false on a test copy so it never writes to the real CRM.
CRM_SYNC_ENABLED=true

# ---- Google Sheets (optional) ----
SHEETS_ENABLED=false
SHEETS_SPREADSHEET_ID=
# Paste the service-account JSON on one line.
SHEETS_CREDENTIALS_JSON=

# ---- identity inquiry (Zohal) ----
ZOHAL_API_TOKEN=

# ---- payment gateway ----
AQAYEPARDAKHT_PIN=

# ---- Telegram (optional; can also be set in Admin → Settings) ----
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URL=
