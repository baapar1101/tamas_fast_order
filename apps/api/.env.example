# ---- runtime ----
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# Set to true when the API sits behind nginx / a load balancer.
TRUST_PROXY=false

# ---- database ----
DATABASE_URL=postgres://tamas:CHANGE_ME@127.0.0.1:5432/tamas
DATABASE_POOL_MAX=10

# ---- web ----
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173
# Any long random string. Generate with: openssl rand -hex 32
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
SESSION_TTL_DAYS=30

# ---- OTP ----
# console = this API generates and verifies the code and prints it to the log.
# eldery  = otp.eldery.ir generates and verifies it; the API calls it server-side.
# rastin/payamresan = this API generates and verifies the code; SMS_PROVIDER selects the SMS gateway.
OTP_PROVIDER=console
OTP_BASE_URL=https://otp.eldery.ir
OTP_API_KEY=
OTP_LENGTH=5
OTP_TTL_SECONDS=180
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=6

# ---- SMS gateway (used by admin tests, order notifications and local OTP) ----
# For direct Payam Resan, set SMS_PROVIDER=payamresan and OTP_PROVIDER=payamresan.
# Keep secrets only in the server .env, never in Git or browser settings.
SMS_PROVIDER=rastin
PAYAMRESAN_API_KEY=
PAYAMRESAN_SENDER=
PAYAMRESAN_BASE_URL=https://api.sms-webservice.com/api/V3

# ---- uploads ----
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
STORAGE_PUBLIC_URL=/uploads
UPLOAD_MAX_BYTES=15728640
# Download remote product images into STORAGE_ROOT in the background.
PRODUCT_IMAGE_MIRROR_ENABLED=true
PRODUCT_IMAGE_MIRROR_INTERVAL_SECONDS=300
PRODUCT_IMAGE_MIRROR_BATCH_SIZE=100
PRODUCT_IMAGE_MIRROR_CONCURRENCY=4

# ---- Google Sheets two-way sync ----
SHEETS_ENABLED=false
SHEETS_SPREADSHEET_ID=
# Either point at the service-account file...
SHEETS_CREDENTIALS_FILE=./service-account.json
# ...or paste the JSON itself (useful on hosts with no persistent disk).
SHEETS_CREDENTIALS_JSON=
# 0 disables the background pass; the admin panel can still run it by hand.
SHEETS_SYNC_INTERVAL_SECONDS=300
# Mirror Users and Orders too, not just the catalogue.
SHEETS_SYNC_PRIVATE_DATA=true

|# ---- bootstrap admin ----
|# Comma-separated phone numbers that get the admin panel on first login.
ADMIN_PHONES=

|# ---- CRM Integration (tamas-fast-order <-> Hesabix/MarkStreet) ----
# Base URL of the CRM API (e.g. https://tamastore.ir or http://localhost:8000).
CRM_API_BASE=https://tamastore.ir
# API key for CRM management endpoints (Bearer token). Leave empty to skip auth.
CRM_API_KEY=
# Business ID in the CRM that this site maps to.
CRM_BUSINESS_ID=1
# Shared secret for webhook signature verification (HMAC-SHA256). Empty = unsigned allowed.
CRM_WEBHOOK_SECRET=
# Enable/disable outbound sync (site -> CRM).
CRM_SYNC_ENABLED=true
# Debounce window in ms before flushing a batch of syncs.
CRM_SYNC_DEBOUNCE_MS=500
# Retry queued product create/update/delete operations against CRM.
CRM_PRODUCT_SYNC_INTERVAL_SECONDS=60

# ---- Zohal identity inquiry ----
# Obtain the bearer token from the Zohal developer panel. Never commit it.
ZOHAL_API_TOKEN=
ZOHAL_API_BASE_URL=https://service.zohal.io/api/v0
ZOHAL_TIMEOUT_MS=15000

# ---- Telegram notifications (DB settings from the admin panel take priority) ----
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Optional: socks4://, socks5:// or socks5h:// URL, with optional username/password.
TELEGRAM_PROXY_URL=
# JSON arrays/objects. It is easier to configure these in Admin > Settings > Telegram Bot.
TELEGRAM_GROUPS=[]
TELEGRAM_ROUTES={}
