{
  "name": "@tamas/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "predev": "node ../../scripts/fix-perms.js",
    "prebuild": "node ../../scripts/fix-perms.js",
    "dev": "cross-env PORT=3001 NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "start:prod": "cross-env PORT=3102 NODE_ENV=production node dist/src/index.js",
    "test": "tsx --test tests/hash.test.ts tests/pagination.test.ts tests/product-image-url.test.ts tests/product-image-sku.test.ts tests/product-title-color.test.ts tests/payamresan-sms.test.ts tests/excel-stock-parser.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:backfill-payments": "tsx scripts/backfill-payments.ts",
    "sync:pull": "tsx scripts/sync-cli.ts pull",
    "sync:push": "tsx scripts/sync-cli.ts push",
    "images:mirror": "tsx scripts/mirror-product-images.ts",
    "images:repair-missing": "tsx scripts/repair-missing-product-images.ts",
    "images:import-sku": "tsx scripts/import-product-images-by-sku.ts",
    "products:repair-codes": "tsx scripts/repair-product-code-prefixes.ts",
    "products:clean-title-colors": "tsx scripts/clean-product-title-colors.ts",
    "products:normalize-title-case": "tsx scripts/normalize-product-title-case.ts",
    "stock:import-excel": "tsx scripts/import-stock-excel.ts",
    "products:audit-sources": "tsx scripts/audit-product-sources.ts"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.5",
    "@tamas/payment": "*",
    "@tamas/shared": "*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.0.1",
    "googleapis": "^170.1.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "sharp": "^0.35.5",
    "socks-proxy-agent": "^10.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
