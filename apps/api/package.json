{
  "name": "@tamas/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "predev": "node ../../scripts/fix-perms.js",
    "prebuild": "node ../../scripts/fix-perms.js",
    "dev": "PORT=3001 NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "start:prod": "PORT=3102 NODE_ENV=production node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "sync:pull": "tsx scripts/sync-cli.ts pull",
    "sync:push": "tsx scripts/sync-cli.ts push"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.0.4",
    "@tamas/shared": "*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "sharp": "^0.33.5",
    "zod": "^3.24.1",
    "fastify-plugin": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}